---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import FaqAnswer from '../../components/FaqAnswer.astro';
import faqData from '../../data/faqs.json';
import { faqStructuredData } from '../../data/structuredData';
import { contact, site } from '../../data/site';
---

<BaseLayout
  locale="en"
  title="Frequently Asked Questions"
  description="Answers about booking, cancellations, payment, insurance receipts, gift cards, accessibility and first appointments with Sabrina The RMT in Ottawa."
  path="/faq/"
  structuredData={faqStructuredData('en')}
>
  <header class="page-header">
    <div class="shell content-narrow">
      <p class="eyebrow">Helpful details</p>
      <h1>Frequently asked questions</h1>
      <p class="page-lede">
        A few practical details to help you feel prepared before your appointment.
      </p>
      <div class="hero-actions"><BookingCta locale="en" /></div>
    </div>
  </header>

  <section class="section faq-contact">
    <div class="shell content-narrow">
      <p class="eyebrow">Need to reach Sabrina?</p>
      <ul class="contact-summary">
        <li>
          <strong>{contact.en.emailPreferred}:</strong>{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>. {contact.en.replyTime}
        </li>
        <li>
          <strong>{contact.en.phoneLabel}:</strong>{' '}
          <a href={site.phoneHref}>{site.phone}</a>. {contact.en.phoneUse}
        </li>
      </ul>
      <p class="small">{contact.en.privacy} <a href="/contact/">All contact details</a></p>
    </div>
  </section>

  <section class="section section-white">
    <div class="shell content-narrow faq-list">
      {
        faqData.faqs.map((faq) => (
          <details id={faq.id}>
            <>
              <summary>{faq.en.question}</summary>
              <FaqAnswer locale="en" text={faq.en.answer} />
            </>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
