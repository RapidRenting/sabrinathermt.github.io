---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookingCta from '../../../components/BookingCta.astro';
import FaqAnswer from '../../../components/FaqAnswer.astro';
import faqData from '../../../data/faqs.json';
import { faqStructuredData } from '../../../data/structuredData';
---

<BaseLayout
  locale="fr"
  title="Foire aux questions"
  description="Réponses sur la réservation, les annulations, le paiement, les reçus d’assurance, les cartes-cadeaux, l’accessibilité et le premier rendez-vous à Ottawa."
  path="/fr/faq/"
  structuredData={faqStructuredData('fr')}
>
  <header class="page-header">
    <div class="shell content-narrow">
      <p class="eyebrow">Renseignements utiles</p>
      <h1>Foire aux questions</h1>
      <p class="page-lede">
        Quelques détails pratiques pour vous aider à vous préparer à votre rendez-vous.
      </p>
      <div class="hero-actions"><BookingCta locale="fr" /></div>
    </div>
  </header>

  <section class="section section-white">
    <div class="shell content-narrow faq-list">
      {
        faqData.faqs.map((faq) => (
          <details>
            <>
              <summary>{faq.fr.question}</summary>
              <FaqAnswer locale="fr" text={faq.fr.answer} />
            </>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
