---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCta from '../components/BookingCta.astro';
import LocationCard from '../components/LocationCard.astro';
import SabrinaPortrait from '../components/SabrinaPortrait.astro';
import { homeStructuredData } from '../data/structuredData';
import FeeSummary from '../components/FeeSummary.astro';
import WeeklySchedule from '../components/WeeklySchedule.astro';
import { locations, site } from '../data/site';
---

<BaseLayout
  locale="en"
  title="Registered Massage Therapist in Ottawa"
  description="Book individualized massage therapy with Sabrina McMorran, Registered Massage Therapist, in Centretown or the Glebe in Ottawa."
  path="/"
  structuredData={homeStructuredData('en')}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Ottawa massage therapy</p>
        <h1>Sabrina McMorran</h1>
        <p class="hero-title">Registered Massage Therapist</p>
        <p class="hero-lede">
          Individualized care designed around how you move, work and live—at two welcoming Ottawa
          locations.
        </p>
        <div class="hero-actions">
          <BookingCta locale="en" />
          <a class="button button-secondary" href="#locations">Choose a location</a>
        </div>
      </div>
      <SabrinaPortrait locale="en" variant="hero" />
    </div>
  </section>

  <section class="section section-white" id="locations">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Book in Ottawa</p>
          <h2>Choose your location</h2>
        </div>
        <p>
          Select the clinic that works best for you. Jane shows current availability, appointment
          options, fees and policies.
        </p>
      </div>
      <WeeklySchedule locale="en" />
      <div class="location-grid">
        {locations.map((location) => <LocationCard locale="en" location={location} />)}
      </div>
    </div>
  </section>

  <FeeSummary locale="en" />

  <section class="section section-white">
    <div class="shell split">
      <div class="split-art">
        <img
          src="/assets/sabrinathermt-mark-cream-480.webp"
          srcset="/assets/sabrinathermt-mark-cream-480.webp 480w, /assets/sabrinathermt-mark-cream-800.webp 800w"
          sizes="(max-width: 860px) calc(100vw - 6rem), 360px"
          width="800"
          height="800"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="split-copy">
        <p class="eyebrow">A thoughtful approach</p>
        <h2>Meet Sabrina</h2>
        <p>
          Sabrina’s background as a competitive dancer inspired her interest in movement and body
          awareness. Her treatments are individualized and may blend Swedish massage, myofascial
          work, trigger-point techniques, joint mobilizations and stretching. Treatment may also
          include work to the muscles around the jaw and temporomandibular joint (TMJ), when
          appropriate and with your consent.
        </p>
        <a class="text-link" href="/meet-sabrina/"
          >Learn more about Sabrina <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-grid">
      <div>
        <h2>Ready to book?</h2>
        <p>Use Jane to view current appointments at Gladstone and Fourth.</p>
        <p class="cta-contact">
          Questions before booking? Email <a href={`mailto:${site.email}`}>{site.email}</a> and allow
          1 to 2 business days for a reply. If you’re running late, call or text <a
            href={site.phoneHref}>{site.phone}</a
          >. Please do not include personal health information.
        </p>
      </div>
      <BookingCta locale="en" />
    </div>
  </section>
</BaseLayout>
