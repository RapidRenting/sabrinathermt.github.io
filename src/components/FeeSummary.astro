---
import { appointments, formatFee, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  en: {
    eyebrow: 'Services & pricing',
    heading: 'Appointment fees',
    intro:
      'Individualized massage therapy, tailored to your needs. Prices are in Canadian dollars and do not include tax.',
    minutes: 'minutes',
    tax: 'before tax',
    online: 'Book online',
    request: 'By request only',
    link: 'See services & pricing',
    path: '/services/',
  },
  fr: {
    eyebrow: 'Services et tarifs',
    heading: 'Tarifs des rendez-vous',
    intro:
      'Une massothérapie individualisée, adaptée à vos besoins. Les prix sont en dollars canadiens et n’incluent pas les taxes.',
    minutes: 'minutes',
    tax: 'avant taxes',
    online: 'Réservation en ligne',
    request: 'Sur demande seulement',
    link: 'Voir les services et tarifs',
    path: '/fr/services/',
  },
}[locale];
---

<section class="section">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2>{copy.heading}</h2>
      </div>
      <div>
        <p>{copy.intro}</p>
        <a class="text-link" href={copy.path}>{copy.link} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ul class="fee-list">
      {
        appointments.map((appointment) => (
          <li class="fee-card">
            <span class="fee-duration">
              {appointment.minutes} {copy.minutes}
            </span>
            <span class="fee-price">
              {formatFee(appointment.fee, locale)} <span class="fee-tax">{copy.tax}</span>
            </span>
            <span class="fee-note">{appointment.requestOnly ? copy.request : copy.online}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .fee-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .fee-card {
    display: grid;
    gap: 0.2rem;
    padding: 1.3rem 1.4rem;
    border: 1px solid rgba(91, 58, 93, 0.15);
    border-radius: 1rem;
    background: var(--white);
  }

  .fee-duration {
    color: var(--slate);
    font-weight: 750;
  }

  .fee-price {
    color: var(--mulberry);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    line-height: 1.2;
  }

  .fee-tax {
    display: block;
    color: var(--charcoal);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
  }

  .fee-note {
    font-size: 0.9rem;
  }

  @media (max-width: 53.75em) {
    .fee-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 23.125em) {
    .fee-list {
      grid-template-columns: 1fr;
    }
  }
</style>
