---
import { nav, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  currentPath: string;
  alternatePath: string;
}

const { locale, currentPath, alternatePath } = Astro.props;
const menuLabel = locale === 'en' ? 'Main navigation' : 'Navigation principale';
const languageLabel = locale === 'en' ? 'Français' : 'English';
const languageCode = locale === 'en' ? 'fr' : 'en';
---

<a class="skip-link" href="#main">{locale === 'en' ? 'Skip to content' : 'Aller au contenu'}</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={locale === 'en' ? '/' : '/fr/'} aria-label="Sabrina The RMT">
      <img
        class="brand-mark"
        src="/assets/sabrinathermt-mark-mulberry.png"
        width="800"
        height="800"
        alt=""
      />
      <span class="brand-lockup">
        <span class="brand-wordmark-crop">
          <img
            class="brand-wordmark"
            src="/assets/sabrinathermt-logo-mulberry.png"
            width="1600"
            height="600"
            alt="SabrinatheRMT"
          />
        </span>
        <span class="brand-slogan" lang="en">Care that meets you where you are.</span>
      </span>
    </a>
    <nav aria-label={menuLabel}>
      <ul class="nav-list">
        {
          nav[locale].map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="language-switch" href={alternatePath} lang={languageCode} hreflang={languageCode}>
      {languageLabel}
    </a>
  </div>
</header>
