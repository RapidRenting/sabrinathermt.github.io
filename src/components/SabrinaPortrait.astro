---
import { headshot } from '../data/headshot';

interface Props {
  locale: 'en' | 'fr';
  variant?: 'profile' | 'hero';
}

const { locale, variant = 'profile' } = Astro.props;
---

{
  headshot && (
    <div class:list={['portrait', { 'portrait-hero': variant === 'hero' }]}>
      <img
        src={headshot.src}
        width={headshot.width}
        height={headshot.height}
        alt={locale === 'fr' ? 'Portrait de Sabrina McMorran' : 'Portrait of Sabrina McMorran'}
        style={`object-position: ${headshot.focalPoint}`}
        loading="eager"
        decoding="async"
      />
    </div>
  )
}

<style>
  .portrait {
    position: relative;
    z-index: 1;
    width: min(100%, 20rem);
    margin-inline: auto;
  }

  .portrait-hero {
    width: min(100%, 520px);
  }

  .portrait::before {
    position: absolute;
    inset: -1rem 1.2rem 1rem -1.2rem;
    z-index: -1;
    border: 1px solid var(--blush);
    border-radius: 48% 52% 45% 55%;
    content: '';
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 48% 52% 45% 55%;
    box-shadow: var(--shadow);
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .portrait-hero {
      max-width: 460px;
    }
  }
</style>
