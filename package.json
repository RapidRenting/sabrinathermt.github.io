{
  "name": "sabrina-the-rmt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/validate-site.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/validate-content.mjs",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "verify:production": "node scripts/verify-production.mjs",
    "worker:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:dry-run": "wrangler deploy --dry-run --env production --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
